"""Module containing Istio's EnvoyFilter related class"""

import json
import logging
import time

import openshift_client as oc
from openshift_client import OpenShiftPythonException

from testsuite.gateway import Gateway
from testsuite.kubernetes import KubernetesObject, modify
from testsuite.kubernetes.client import KubernetesClient
from testsuite.utils.constants import EXTENSION_POLICY_PROPAGATION_WAIT, WASM_PLUGIN_SYNC_WAIT

logger = logging.getLogger(__name__)

GATEWAY_NAME_LABEL = "gateway.networking.k8s.io/gateway-name"


def kuadrant_envoyfilter_names(gateway_name: str) -> tuple[str, str]:
    """Return Kuadrant WASM and ratelimit EnvoyFilter names for a gateway."""
    return f"kuadrant-{gateway_name}", f"kuadrant-ratelimiting-{gateway_name}"


def patch_kuadrant_managed_envoyfilters_to_workload_selector(cluster: KubernetesClient, gateway: Gateway) -> None:
    """Replace targetRefs with workloadSelector on Kuadrant-managed EnvoyFilters.

    Workaround for Istio/RHSM setups where EnvoyFilters attached only via targetRefs
    are not applied to Gateway API gateway pods.
    """
    gateway_name = gateway.name()
    patch_body = json.dumps(
        [
            {"op": "remove", "path": "/spec/targetRefs"},
            {
                "op": "add",
                "path": "/spec/workloadSelector",
                "value": {"labels": {GATEWAY_NAME_LABEL: gateway_name}},
            },
        ]
    )

    for ef_name in kuadrant_envoyfilter_names(gateway_name):
        with cluster.context:
            try:
                ef = oc.selector(f"envoyfilter.networking.istio.io/{ef_name}").object()
            except OpenShiftPythonException:
                logger.warning("Kuadrant EnvoyFilter %s not found, skipping workloadSelector patch", ef_name)
                continue

            if not getattr(ef.model.spec, "targetRefs", None):
                logger.info("EnvoyFilter %s already uses workloadSelector, skipping", ef_name)
                continue

        result = cluster.do_action(
            "patch",
            "envoyfilter",
            ef_name,
            "--type=json",
            "-p",
            patch_body,
            auto_raise=False,
        )
        if result.status() != 0:
            logger.warning(
                "Failed to patch EnvoyFilter %s to workloadSelector: %s",
                ef_name,
                result.err(),
            )
            continue
        logger.info("Patched EnvoyFilter %s to use workloadSelector for gateway %s", ef_name, gateway_name)

    time.sleep(EXTENSION_POLICY_PROPAGATION_WAIT + WASM_PLUGIN_SYNC_WAIT)


class EnvoyFilter(KubernetesObject):
    """Istio EnvoyFilter object for patching Envoy proxy configuration"""

    @classmethod
    def create_instance(
        cls,
        cluster,
        name,
        gateway: Gateway,
        labels: dict[str, str] = None,
    ):
        """Creates new instance of EnvoyFilter targeting a Gateway"""
        model: dict = {
            "apiVersion": "networking.istio.io/v1alpha3",
            "kind": "EnvoyFilter",
            "metadata": {
                "name": name,
                "namespace": cluster.project,
                "labels": labels,
            },
            "spec": {
                "targetRefs": [gateway.reference],
                "configPatches": [],
            },
        }

        return cls(model, context=cluster.context)

    @modify
    def add_client_cert_validation(self, port_number: int, ca_cert_path: str):
        """Adds a configPatch that enables client certificate validation on a listener"""
        self.model.spec.configPatches.append(
            {
                "applyTo": "FILTER_CHAIN",
                "match": {
                    "context": "GATEWAY",
                    "listener": {
                        "portNumber": port_number,
                    },
                },
                "patch": {
                    "operation": "MERGE",
                    "value": {
                        "transport_socket": {
                            "name": "envoy.transport_sockets.tls",
                            "typed_config": {
                                "@type": "type.googleapis.com/envoy.extensions.transport_sockets."
                                "tls.v3.DownstreamTlsContext",
                                "requireClientCertificate": True,
                                "commonTlsContext": {
                                    "validationContext": {
                                        "trusted_ca": {
                                            "filename": ca_cert_path,
                                        }
                                    }
                                },
                            },
                        }
                    },
                },
            }
        )


def create_native_ratelimit_workaround(
    cluster: KubernetesClient,
    gateway: Gateway,
    rate_limit,
    limitador,
) -> EnvoyFilter:
    """Create a native Envoy RLS filter for the current route-targeted RLP.

    This is a temporary ppc64le workaround for the RHCL Wasm filter issue.
    The function reads the generated Limitador rule dynamically and creates
    an Envoy native rate-limit filter for the current test Gateway.
    """
    import re

    target_ref = rate_limit.model.spec.targetRef
    target_kind = str(target_ref.kind)
    target_name = str(target_ref.name)

    if target_kind != "HTTPRoute":
        raise RuntimeError(
            "The temporary native RLP workaround currently supports only "
            f"HTTPRoute targets. Current target kind: {target_kind}"
        )

    expected_domain = f"{cluster.project}/{target_name}"
    descriptor_pattern = re.compile(
        r'descriptors\[0\]\["([^"]+)"\]\s*==\s*"([^"]+)"'
    )

    descriptor_key = None
    descriptor_value = None
    matched_domain = None
    timeout_seconds = 90
    poll_interval_seconds = 2
    deadline = time.time() + timeout_seconds

    while time.time() < deadline:
        limitador.refresh()

        limits = getattr(limitador.model.spec, "limits", [])

        for generated_limit in limits:
            generated_domain = str(
                getattr(generated_limit, "namespace", "")
            )

            if generated_domain != expected_domain:
                continue

            conditions = getattr(generated_limit, "conditions", [])

            for condition in conditions:
                match = descriptor_pattern.search(str(condition))

                if match:
                    descriptor_key = match.group(1)
                    descriptor_value = match.group(2)
                    matched_domain = generated_domain
                    break

            if descriptor_key is not None:
                break

        if descriptor_key is not None:
            break

        time.sleep(poll_interval_seconds)

    if descriptor_key is None or descriptor_value is None:
        raise RuntimeError(
            "Unable to find the generated Limitador descriptor for "
            f"domain {expected_domain} within {timeout_seconds} seconds"
        )

    gateway_name = gateway.name()
    filter_name = f"ppc64le-native-rlp-{gateway_name}"

    logger.info(
        "Creating native RLP workaround %s for gateway=%s domain=%s "
        "descriptor=%s value=%s",
        filter_name,
        gateway_name,
        matched_domain,
        descriptor_key,
        descriptor_value,
    )

    model = {
        "apiVersion": "networking.istio.io/v1alpha3",
        "kind": "EnvoyFilter",
        "metadata": {
            "name": filter_name,
            "namespace": cluster.project,
            "labels": {
                "testsuite.kuadrant.io/workaround": "ppc64le-native-rlp",
            },
        },
        "spec": {
            "workloadSelector": {
                "labels": {
                    GATEWAY_NAME_LABEL: gateway_name,
                },
            },
            "configPatches": [
                {
                    "applyTo": "HTTP_FILTER",
                    "match": {
                        "context": "GATEWAY",
                        "listener": {
                            "filterChain": {
                                "filter": {
                                    "name": (
                                        "envoy.filters.network."
                                        "http_connection_manager"
                                    ),
                                    "subFilter": {
                                        "name": "envoy.filters.http.router",
                                    },
                                },
                            },
                        },
                    },
                    "patch": {
                        "operation": "INSERT_BEFORE",
                        "value": {
                            "name": "envoy.filters.http.ratelimit",
                            "typed_config": {
                                "@type": (
                                    "type.googleapis.com/envoy.extensions."
                                    "filters.http.ratelimit.v3.RateLimit"
                                ),
                                "domain": matched_domain,
                                "failure_mode_deny": False,
                                "timeout": "100ms",
                                "rate_limit_service": {
                                    "transport_api_version": "V3",
                                    "grpc_service": {
                                        "envoy_grpc": {
                                            "cluster_name": (
                                                "kuadrant-ratelimit-service"
                                            ),
                                        },
                                    },
                                },
                            },
                        },
                    },
                },
                {
                    "applyTo": "VIRTUAL_HOST",
                    "match": {
                        "context": "GATEWAY",
                        "routeConfiguration": {},
                    },
                    "patch": {
                        "operation": "MERGE",
                        "value": {
                            "rate_limits": [
                                {
                                    "actions": [
                                        {
                                            "generic_key": {
                                                "descriptor_key": descriptor_key,
                                                "descriptor_value": descriptor_value,
                                            },
                                        },
                                    ],
                                },
                            ],
                        },
                    },
                },
            ],
        },
    }

    native_filter = EnvoyFilter(
        dict_to_model=model,
        context=cluster.context,
    )
    native_filter.commit()

    logger.info(
        "Created native RLP workaround %s for gateway %s",
        filter_name,
        gateway_name,
    )

    time.sleep(
        EXTENSION_POLICY_PROPAGATION_WAIT
        + WASM_PLUGIN_SYNC_WAIT
    )

    return native_filter
